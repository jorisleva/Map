# ── Navigation Liquid Glass — environment ────────────────────────────────────
# Copy to `.env` and fill in. Only EXPO_PUBLIC_* vars are bundled into the app.
# MISTRAL_API_KEY (no EXPO_PUBLIC_ prefix) stays server-side (used by the proxy
# route app/api/mistral+api.ts) and is NEVER shipped in the client bundle.

# ── Mistral AI ────────────────────────────────────────────────────────────────
# SECURE (recommended): keep the key server-side and let the app call the proxy.
MISTRAL_API_KEY=

# QUICK DEV (insecure): embed the key in the client so the app calls Mistral
# directly. If this is set (and MODE isn't 'proxy'), the app uses direct mode.
# EXPO_PUBLIC_MISTRAL_API_KEY=

# Force a transport: 'proxy' | 'direct'. Leave empty for auto
# (direct when EXPO_PUBLIC_MISTRAL_API_KEY is set, otherwise proxy).
# EXPO_PUBLIC_MISTRAL_MODE=
# EXPO_PUBLIC_MISTRAL_MODEL=mistral-small-latest

# Absolute origin of the proxy when running on a real device (native can't use a
# relative '/api/...' URL). e.g. http://192.168.1.20:8081 for the Expo dev server.
# EXPO_PUBLIC_API_BASE_URL=

# ── OpenStreetMap services (all optional — sensible key-less defaults) ─────────
# A MapTiler key switches the base map to MapTiler's nicer OSM style.
# EXPO_PUBLIC_MAPTILER_KEY=
# EXPO_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
# EXPO_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
# EXPO_PUBLIC_PHOTON_URL=https://photon.komoot.io
# EXPO_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Required by OSM's usage policy — identify your app (put a real contact).
# EXPO_PUBLIC_APP_USER_AGENT=NavigationLiquidGlass/1.0 (contact@example.com)
